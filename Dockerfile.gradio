FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    GRADIO_PORT=7860 \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SKIP_LOCALHOST_CHECK=true \
    NO_PROXY=localhost,127.0.0.1 \
    no_proxy=localhost,127.0.0.1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /app/.venv

COPY pyproject.toml /app/pyproject.toml
COPY src /app/src

RUN /app/.venv/bin/python -m pip install --upgrade pip \
    && /app/.venv/bin/pip install . \
    && /app/.venv/bin/python -c "import gradio; print('gradio', gradio.__version__)"

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 7860

# ECS: set env vars in task definition (DATABASE_URL, OPENAI_KEY, LANGFUSE_*, etc.).
CMD ["capterra-chat-ui", "--port", "7860"]
